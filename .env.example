VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: override Netlify Function paths if you host endpoints elsewhere
VITE_DRIVE_UPLOAD_ENDPOINT=/.netlify/functions/driveUpload
VITE_DRIVE_DELETE_ENDPOINT=/.netlify/functions/driveDelete

# NOTE: variables below are SERVER-ONLY (Netlify Environment Variables), do not expose in client .env
# FIREBASE_SERVICE_ACCOUNT_JSON={...firebase admin sdk json...}
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={...google service account json with Drive API enabled...}
# GOOGLE_DRIVE_ROOT_FOLDER_NAME=ats-storage
# GOOGLE_DRIVE_ROOT_FOLDER_ID=your_shared_drive_folder_id

# Telegram bot (truck-bot.js webhook + all digest/reminder functions)
# TELEGRAM_BOT_TOKEN=your_botfather_token
# TELEGRAM_CHAT_ID=your_personal_chat_id       (get via /myid in the bot, personal digests/nudges go here)
# TELEGRAM_HR_CHAT_ID=hr_group_chat_id

# RingCentral — Emma HR's own call stats, folded into the evening HR digest
# RC_CLIENT_ID=...
# RC_CLIENT_SECRET=...
# RC_JWT_TOKEN=...

# NOTE: whole-team, multi-RC-account call stats (the /calls command, midday
# nudge, EOD digest) live on a SEPARATE Netlify site — see call-stats-bot/ —
# because tracking two RC accounts' credentials alongside this site's Firebase
# key blows AWS Lambda's 4KB total env-var cap. Its env vars (RC_CLIENT_ID(_2),
# RC_CLIENT_SECRET(_2), RC_JWT_TOKEN(_2), ANTHROPIC_API_KEY, TELEGRAM_*) are
# configured on that site, not here.
