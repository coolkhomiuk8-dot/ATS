VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: override Netlify Function paths if you host endpoints elsewhere
VITE_DRIVE_UPLOAD_ENDPOINT=/.netlify/functions/driveUpload
VITE_DRIVE_DELETE_ENDPOINT=/.netlify/functions/driveDelete

# NOTE: variables below are SERVER-ONLY (Netlify Environment Variables), do not expose in client .env
# FIREBASE_SERVICE_ACCOUNT_JSON={...firebase admin sdk json...}
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={...google service account json with Drive API enabled...}
# GOOGLE_DRIVE_ROOT_FOLDER_NAME=ats-storage
# GOOGLE_DRIVE_ROOT_FOLDER_ID=your_shared_drive_folder_id

# Telegram bot (truck-bot.js webhook + all digest/reminder functions)
# TELEGRAM_BOT_TOKEN=your_botfather_token
# TELEGRAM_CHAT_ID=your_personal_chat_id       (get via /myid in the bot, personal digests/nudges go here)
# TELEGRAM_HR_CHAT_ID=hr_group_chat_id

# RingCentral call stats — account 1 (existing, e.g. Emma HR)
# RC_CLIENT_ID=...
# RC_CLIENT_SECRET=...
# RC_JWT_TOKEN=...

# RingCentral call stats — account 2 (second RC account, rest of the team)
# Create a separate JWT app in that account's RingCentral Developer Console:
#   1. https://developers.ringcentral.com -> the *other* account -> Console -> Apps -> Create App
#   2. Auth type: "JWT auth flow", App type: "Server-only (No UI)"
#   3. Permissions: "Read Call Log" (must be granted at company/account level, not just personal —
#      the JWT user should be an account admin, since we're reading OTHER extensions' call logs)
#   4. Generate a JWT credential for that admin user (Console -> your app -> Credentials -> JWT)
# RC_CLIENT_ID_2=...
# RC_CLIENT_SECRET_2=...
# RC_JWT_TOKEN_2=...

# NOTE: which extensions are tracked (id -> name) lives in code, not env vars —
# see ACCOUNT1_EXTENSIONS / ACCOUNT2_EXTENSIONS in netlify/functions/_ringcentral.js.
# Netlify bakes every env var into every function's Lambda bundle (AWS 4KB limit),
# so a long non-secret roster string belongs in the source file, not here.

# Optional — enables a short AI commentary line in call-stats digests (uses @anthropic-ai/sdk)
# ANTHROPIC_API_KEY=sk-ant-...
