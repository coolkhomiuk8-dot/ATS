# Separate Netlify site — whole-team call stats across both RingCentral accounts.
# Deployed independently from the main ATS site so its env vars don't share
# that site's 4KB AWS Lambda budget (already consumed by Firebase creds etc).

# RingCentral account 1
# RC_CLIENT_ID=...
# RC_CLIENT_SECRET=...
# RC_JWT_TOKEN=...

# RingCentral account 2
# RC_CLIENT_ID_2=...
# RC_CLIENT_SECRET_2=...
# RC_JWT_TOKEN_2=...

# Telegram — sends to the owner's personal chat, and to the dispatch group
# chat (@-mention the bot there to ask a question; also gets an 18:00 ET
# weekday digest)
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
# TELEGRAM_DISPATCH_CHAT_ID=...

# Optional — enables a short AI commentary line in the digests + dashboard notes
# ANTHROPIC_API_KEY=sk-ant-...

# Required for the dashboard's history storage (Netlify Blobs). Zero-config
# auto-detection doesn't work here since this site is deployed manually via
# CLI, not git-linked CI — see _blobs-store.js. Use a Netlify personal access
# token (User Settings -> Applications -> New access token).
# NETLIFY_BLOBS_TOKEN=...

# NOTE: which extensions are tracked (id -> name) lives in code, not env vars —
# see ACCOUNT1_EXTENSIONS / ACCOUNT2_EXTENSIONS in netlify/functions/_ringcentral.js.
